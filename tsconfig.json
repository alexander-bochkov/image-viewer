{
  "compilerOptions": {
    /* Completeness */
    "skipLibCheck": true,

    /* Emit */
    "noEmit": true,

    /* Interop Constraints */
    "isolatedModules": true,

    /* Language and Environment */
    "jsx": "react-jsx",
    "moduleDetection": "force",

    /* Modules */
    "moduleResolution": "bundler",
    "paths": {
      "scripts": ["./src/scripts/index"],
      "shared/*": ["./src/shared/*"],
      "ui": ["./src/ui/index"],
      "ui/*": ["./src/ui/*"]
    },

    /* Type Checking */
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
