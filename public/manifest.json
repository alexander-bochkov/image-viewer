{
  "manifest_version": 3,
  "name": "SwiftView",
  "version": "0.1.0",
  "description": "Google Chrome extension for viewing images.",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["content.css"]
    }
  ]
}
