{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "source": [":PACKAGE:", "!features/**", "!types/**"],
                "type": false
              },
              { "source": ":PACKAGE:", "type": false },
              { "source": [":PATH:", "!**/*.css"], "type": false },
              ":BLANK_LINE:",
              {
                "source": [":PACKAGE:", "!features/**", "!types/**"],
                "type": true
              },
              { "source": ":PACKAGE:", "type": true },
              { "source": ":PATH:", "type": true },
              ":BLANK_LINE:",
              "**/*.css"
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "includes": [
      "**",
      "!public/manifest.json",
      "!bun.lock",
      "!package.json",
      "!tsconfig.json"
    ]
  },
  "formatter": {
    "formatWithErrors": true,
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "style": {
        "useImportType": {
          "level": "info",
          "options": {
            "style": "separatedType"
          }
        }
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
